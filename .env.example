# Copy to .env and adjust.

# UID/GID the container runs as. They must own ./config and be able to write the workspace.
PUID=1000
PGID=1000
TZ=UTC

# Folder Claude works in (mounted at /workspace)
WORKSPACE_DIR=./workspace

# Name of the web-terminal session in claude.ai/code and the Claude app
CLAUDE_RC_NAME=claude-web

# Host port for the web terminal (bound to 127.0.0.1)
TTYD_PORT=7681

# Optional basic auth for the web terminal, as user:password.
# Leave empty only when an authenticating proxy sits in front.
TTYD_CREDENTIAL=

# Who may use the web terminal (see README, "Allowed users"): none, pomerium or header
CLAUDE_WEB_AUTH=none
CLAUDE_WEB_ALLOWED_USERS=
# pomerium mode
CLAUDE_WEB_POMERIUM_JWKS_URL=
CLAUDE_WEB_POMERIUM_AUDIENCE=
# header mode (Tailscale Serve sets Tailscale-User-Login)
CLAUDE_WEB_AUTH_HEADER=Tailscale-User-Login
CLAUDE_WEB_TRUSTED_PROXIES=127.0.0.1/32,::1/128
