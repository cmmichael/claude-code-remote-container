# Copy to pomerium.env (keep it out of git).
# Generate each secret with: head -c32 /dev/urandom | base64
SHARED_SECRET=
COOKIE_SECRET=
# OAuth client from your identity provider. For Google: an OAuth client of type
# "Web application" with redirect URI https://auth.example.com/oauth2/callback
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
# A stable signing key keeps the container's cached JWKS valid across restarts.
# Generate: openssl ecparam -genkey -name prime256v1 -noout | base64 -w0
SIGNING_KEY=
